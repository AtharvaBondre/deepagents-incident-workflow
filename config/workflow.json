{
  "schema_version": 1,
  "repository": {
    "id": "example-org/event-indexer",
    "allowed_services": [
      "backend"
    ],
    "allowed_environments": [
      "prod"
    ],
    "allowed_patch_prefixes": [
      "app/"
    ]
  },
  "evidence": {
    "maximum_window_minutes": 15,
    "maximum_log_records": 100,
    "maximum_database_rows": 20,
    "allowed_database_views": [
      "incident_context",
      "incident_record_indexing_context"
    ]
  },
  "validation": {
    "required_test_argv": [
      "python",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests",
      "-v"
    ]
  },
  "deepagents": {
    "default_sdk_language": "python",
    "runtimes": {
      "python": {
        "sdk_version": "0.7.11",
        "worker": "scripts/deepagents_worker.py"
      },
      "typescript": {
        "sdk_version": "1.13.2",
        "node_version": "22.23.2",
        "worker_source": "typescript-runtime/src/deepagents_worker.ts",
        "package_lock": "typescript-runtime/package-lock.json",
        "worker_build_sha256": "a4503ba699ee7cc9f6b429564baa818d4682922591a73d2394467bceb71fd4e8"
      }
    },
    "allowed_filesystem_tools": [
      "ls",
      "read_file",
      "write_file",
      "edit_file",
      "glob",
      "grep"
    ],
    "maximum_attempt_seconds": 300
  },
  "limits": {
    "hard_maximum_attempts": 5,
    "hard_maximum_remediation_seconds": 1500
  }
}
