{
  "schema_version": 1,
  "repository": {
    "id": "example-org/event-indexer",
    "allowed_services": [
      "backend"
    ],
    "allowed_environments": [
      "prod"
    ],
    "allowed_patch_prefixes": [
      "app/"
    ]
  },
  "evidence": {
    "maximum_window_minutes": 15,
    "maximum_log_records": 100,
    "maximum_database_rows": 20,
    "allowed_database_views": [
      "incident_context",
      "incident_record_indexing_context"
    ]
  },
  "validation": {
    "required_test_argv": [
      "python",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests",
      "-v"
    ]
  },
  "deepagents": {
    "sdk_version": "0.7.8",
    "worker": "scripts/deepagents_worker.py",
    "allowed_filesystem_tools": [
      "ls",
      "read_file",
      "write_file",
      "edit_file",
      "glob",
      "grep"
    ],
    "maximum_attempt_seconds": 300
  },
  "limits": {
    "hard_maximum_attempts": 5,
    "hard_maximum_remediation_seconds": 1500
  }
}
