{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/deepagents-incident-workflow/deepagents-request.schema.json",
  "title": "Controller-to-Deep-Agents request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt",
    "remaining_budget_seconds",
    "incident",
    "evidence",
    "feedback",
    "policy",
    "output_contract"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
    "remaining_budget_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 300
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "issue_id",
        "repository",
        "base_revision",
        "service",
        "environment",
        "summary",
        "instructions",
        "content_trust"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "issue_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repository": { "type": "string", "minLength": 1, "maxLength": 256 },
        "base_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "service": { "type": "string", "minLength": 1, "maxLength": 128 },
        "component": { "type": "string", "minLength": 1, "maxLength": 128 },
        "environment": { "type": "string", "minLength": 1, "maxLength": 64 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "content_trust": { "const": "untrusted_data" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_trust", "packet"],
      "properties": {
        "content_trust": { "const": "untrusted_data" },
        "packet": { "type": "object" }
      }
    },
    "feedback": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
          "stage": { "type": "string", "maxLength": 128 },
          "candidate_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "command": { "type": "string", "maxLength": 1000 },
          "exit_code": { "type": "integer" },
          "passed": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 1000 },
          "output": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "controller_is_sole_acceptor",
        "maximum_changed_paths",
        "required_test",
        "workspace_root",
        "model_must_not_claim_acceptance"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*/$" }
        },
        "controller_is_sole_acceptor": { "const": true },
        "maximum_changed_paths": { "type": "integer", "minimum": 1, "maximum": 20 },
        "required_test": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "workspace_root": { "const": "/" },
        "model_must_not_claim_acceptance": { "const": true }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "candidate_patch", "acceptance"],
      "properties": {
        "authority": { "const": "advisory-only" },
        "candidate_patch": { "const": "derived-by-controller-from-workspace" },
        "acceptance": { "const": "controller-owned-verification-only" }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_trust", "packet"],
      "properties": {
        "content_trust": { "const": "untrusted_prior_model_output" },
        "packet": { "type": "object" }
      }
    },
    "controller_approved_execution_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "issue_id",
        "controller_approved",
        "source",
        "edits",
        "required_test"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "issue_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "controller_approved": { "const": true },
        "source": { "type": "string", "minLength": 1, "maxLength": 128 },
        "edits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "old_fragment", "new_fragment"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "old_fragment": { "type": "string", "minLength": 1, "maxLength": 32768 },
              "new_fragment": { "type": "string", "minLength": 1, "maxLength": 32768 }
            }
          }
        },
        "required_test": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  }
}
